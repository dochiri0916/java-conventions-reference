<FindBugsFilter>
    <!-- Adapter DTOs and Application Results with List fields — records are DTOs, mutability exposure is acceptable -->
    <Match>
        <Bug code="EI,EI2"/>
        <Or>
            <Class name="com.dochiri.tooltestlab.cart.adapter.in.web.response.CartResponse"/>
            <Class name="com.dochiri.tooltestlab.product.adapter.in.web.response.ProductListResponse"/>
            <Class name="com.dochiri.tooltestlab.product.adapter.in.web.response.ProductListResponse$ProductSummary"/>
            <Class name="com.dochiri.tooltestlab.product.adapter.in.web.response.ProductResponse"/>
            <Class name="com.dochiri.tooltestlab.product.application.port.in.RegisterProductResult"/>
            <Class name="com.dochiri.tooltestlab.product.application.port.in.GetProductResult"/>
            <Class name="com.dochiri.tooltestlab.product.application.port.in.ListProductsResult"/>
            <Class name="com.dochiri.tooltestlab.product.application.port.in.ListProductsResult$ProductSummary"/>
            <Class name="com.dochiri.tooltestlab.review.adapter.in.web.response.ReviewResponse"/>
            <Class name="com.dochiri.tooltestlab.order.adapter.in.web.response.OrderResponse"/>
        </Or>
    </Match>

    <!-- Controllers/Service constructors — Spring beans, injection is safe -->
    <Match>
        <Bug code="EI2"/>
        <Or>
            <Class name="com.dochiri.tooltestlab.review.adapter.in.web.ReviewController"/>
            <Class name="com.dochiri.tooltestlab.review.application.service.ReviewService"/>
            <Class name="com.dochiri.tooltestlab.cart.adapter.in.web.CartController"/>
        </Or>
    </Match>

    <!-- Test code: equals() called with incompatible type is intentional for equals contract verification -->
    <Match>
        <Bug code="EC"/>
        <Source name="~.*Test\.java"/>
    </Match>

    <!-- Test code: dead store and return value ignored are intentional in tests -->
    <Match>
        <Bug code="DLS,RV"/>
        <Source name="~.*Test\.java"/>
    </Match>

    <!-- InvalidOrderStatusException serialVersionUID — non-serializable field is fine -->
    <Match>
        <Bug code="Se"/>
        <Class name="com.dochiri.tooltestlab.order.domain.exception.InvalidOrderStatusException"/>
    </Match>
</FindBugsFilter>
